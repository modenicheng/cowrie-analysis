# e3-weekly-report.service — 周报生成（oneshot，由 e3-weekly-report.timer 触发）
#
# 分析窗口：上一自然周 [上周一 00:00, 本周一 00:00) Asia/Shanghai（SPEC §11）。
#
# 权限与凭据（SPEC §14）：
#   - 凭据 DEEPSEEK_API_KEY（llm.env）+ NTFY_TOKEN（ntfy.env）+ 多吉云
#     AccessKey/SecretKey（doge.env，报告图表上传用；report_image.enabled=false
#     时文件可缺省），各文件均须 0600、owner e3sec:e3sec，由 systemd(PID 1) 在
#     降权前读取。
#   - 这些凭据绝不能给 script-runner 进程：runner 由 analyst 以空环境子进程
#     启动，凭据不继承（SPEC §9/§18）。

[Unit]
Description=E3 Security Analyst - weekly report (oneshot, triggered by timer)
Documentation=file:/etc/e3-security-analyst/config.yaml
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=e3sec
Group=e3sec
EnvironmentFile=-/etc/e3-security-analyst/llm.env
EnvironmentFile=-/etc/e3-security-analyst/ntfy.env
EnvironmentFile=-/etc/e3-security-analyst/doge.env
ExecStart=/usr/local/bin/e3-analyst report --type weekly --config /etc/e3-security-analyst/config.yaml
# 周报数据量大、LLM 轮数更多，oneshot 整体上限 45 分钟。
TimeoutStartSec=45min

# —— systemd 加固（SPEC §14）——
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
# 内存硬顶（安全审查 High#1）：script-runner 子进程的单个内建调用（如
# "A".repeat / Array.fill）打不断 vm.Interrupt，可能分配 GB 级内存。子进程内
# 已设 192MiB Go 软限（debug.SetMemoryLimit），本 cgroup 硬顶 256M（>软限，
# 给 GC 留余量）作最终兜底；OOM 击杀 cgroup 内最大进程（通常是子进程本身），
# oneshot 失败由 timer 下一周期重试，不波及同机其他服务。
MemoryMax=256M

# 报告归档与通知状态写入状态目录。
ReadWritePaths=/var/lib/e3-security-analyst

StandardOutput=journal
StandardError=journal
SyslogIdentifier=e3-weekly-report
