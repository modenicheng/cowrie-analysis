# 构建产物
/bin/
*.exe
# 锚定仓库根：根目录裸 go build 的产物；避免误伤子目录同名文件（如 docs/e3-analyst）
/e3-collector
/e3-analyst
/e3-script-runner

# 运行时数据（不入库：数据库/归档报告/本地状态）
*.db
*.db-wal
*.db-shm
/state/
/var/
# 锚定仓库根：仅忽略根目录的报告归档目录；未锚定的 reports/ 会连源码包
# internal/reports/ 一并忽略，导致该包从未进入版本库（克隆后无法构建）。
/reports/

# 本地配置与凭据（绝不提交）
config.local.yaml
*.env
!deploy/env.example

# 编辑器/系统/工具
.idea/
.vscode/
.zcode/
*.swp
.DS_Store
Thumbs.db
